---
layout: base.njk
title: Home
description: Freelance illustration inspired by retro tech and fuelled by open web counterculture
bodyColor: bg-highlight
---

{# HEADER #}
<div id="home-header" class="section medium-grid bg-highlight">
    <div class="section-column">
        <div class="header-featured-image bg-muted">
            {% image "source/assets/img/featured/novision-02.png", "Illustration of beaten down character", [720, 1400], "(min-width: 720px) 720px, 1400px", { eager: true } %}
            {# BADGE #}
            <div class="header-badge flex-center no-blend hide-small fade-in">
                {% image "source/assets/img/nogood_sign.png", "NoGood sign" %}
                <svg class="header-badge-text" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <path id="circle-path" d="M 50,50 m -35,0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" />
                    </defs>
                    <text>
                        <textPath href="#circle-path" class="uppercase pixel-font">UP TO NOGOOD ⚡ UP TO NOGOOD ⚡
                        </textPath>
                    </text>
                </svg>
            </div>
        </div>
    </div>
    {# INTRO #}
    <div class="section-column sticky-two-rows">
        <div class="sticky-wrapper">
            <div class="sticky">
                <div class="header-introduction">
                    <h1 class="header">
                        Illustration inspired by retro tech and fuelled by open web counterculture.
                    </h1>
                    <div class="spacer-large"></div>
                </div>
            </div>
        </div>

        {# CONTACT #}
        <div class="place-bottom">
            <p class="text-large margin-bottom-none">
                I’m Thomas, aka NoGood, an illustrator based in Amsterdam. I started working under the pseudonym in 2021. It provided a space to experiment and create work I found meaningful.
            </p>
            <div class="spacer-large line"></div>
            <h5 class="uppercase pixel-font">System Log</h5>
            <div class="spacer-large"></div>
            <div class="flex-space-between flex-align-center">
                <span class="text-small uppercase pixel-font offset-down-2">PROJECT</span>
                <a href="/work/">Røde Go Gen3</a>
            </div>
            <div class="spacer line"></div>
            <div class="flex-space-between flex-align-center">
                <span class="text-small uppercase pixel-font offset-down-2">PRODUCT</span>
                <a href="/the-nogood-book/">The NoGood Book</a>
            </div>
            <div class="spacer line"></div>
            <div class="flex-space-between flex-align-center">
                <span class="text-small uppercase pixel-font offset-down-2">ADDITION</span>
                <a href="/press/the-nogood-book/">The NoGood Book Press Kit</a>
            </div>
            <div class="spacer line"></div>
            <div class="flex-space-between flex-align-center">
                <span class="text-small uppercase pixel-font offset-down-2">UPDATE</span>
                {% for post in collections.feedPosts %}
                    {% if loop.first %}<a href="{{ post.url }}">{{ post.data.title }}</a>{% endif %}
                {% endfor %}
            </div>
            <div class="spacer line"></div>
            <div class="flex-space-between flex-align-center">
                <span class="text-small uppercase pixel-font offset-down-2">PATREON</span>
                <a href="{{ patreonPosts[0].url }}" target="_blank" rel="noopener" data-umami-event="patreon-click" data-umami-event-location="system-log">{{ patreonPosts[0].title }}</a>
            </div>
        </div>
    </div>
    {# STATUS #}
    <div class="section-column hide-small hide-medium sticky-two-rows">
        <div class="sticky-wrapper">
            <div class="sticky">
                {# NOW #}
                <div class="now">
                    <h5 class="uppercase pixel-font">Now</h5>
                    <p>
                        I launched a Patreon and, predictably, made it my latest obsession. With client work quiet, I’m focussing on promoting <a href="/the-nogood-book/">The NoGood Book</a>.
                    </p>
                    <div class="spacer-small"></div>
                    <a href="/now/">Read more</a>
                </div>
                <div class="spacer-large line"></div>
                {# LATEST PRODUCT #}
                <div class="latest-product">
                    <h5 class="uppercase pixel-font">
                        <a href="/shop/">Shop</a>
                        > Latest
                    </h5>
                    <div class="spacer-small"></div>
                    {% for post in collections.product | reverse %}
                    {% if loop.index0 < 1 %} {# IMAGE #} <div class="shop-featured-image zoom bg-{{ post.data.site.background_color }} {% if
                                    post.data.site.override_blend_mode === true %}no-blend{% endif %}">
                        <a href="{{ post.url }} ">
                            {% image post.data.site.featured_image_url, post.data.title %}
                        </a>
                </div>
                <div class="spacer-small"></div>
                <div>
                    <a href="{{ post.url }}">{{ post.data.title }} — {% if post.data.site.sold_out === true %}Sold out{% else %}€{{ post.data.snipcart.price }}{% endif %}</a>
                </div>
                {% endif %}
                {% endfor %}
            </div>
            <div class="spacer-large line"></div>
        </div>
    </div>
    {# RECENT ZAPS #}
    <div class="place-bottom">
        <h5 class="uppercase pixel-font">Recent supporters</h5>
        <div class="spacer-small"></div>
        <div id="home-zap-feed" class="zap-feed animate-in"></div>
    </div>
</div>
</div>
{# PORTFOLIO #}
<div id="portfolio" class="section large-grid bg-dark text-light">
    <div class="section-column">
        <div class="inner-column pixel-font uppercase">
            <h3>featured work / <a href="/work/">all work</a></h3>
        </div>
    </div>
    <div class="section-column">
        <div class="inner-column">
            <h2 class="padding-right-small">My illustrations, through the rickety hardware and clunky modded devices they feature, are informed by notions of ownership and control.</h2>
            <div class="spacer-extralarge"></div>
            <div class="flex-row flex-align-center gap">
                <span class="tag pixel-font {% if status.available %}tag-available{% else %}tag-unavailable{% endif %}">
                    {% if status.available %}{{ status.availability_label }}{% else %}{{ status.unavailability_label }}{% endif %}
                </span>
                <span class="offset-up-1"><a href="mailto:{{ settings.metadata.site_email }}">{{ settings.metadata.site_email }}</a></span>
            </div>
        </div>
    </div>
</div>
<div class="section section-fullwidth bg-dark text-light">
    <div class="marquee client-marquee pixel-font header-large uppercase" role="marquee" aria-label="Selected clients">
        <ul class="marquee-content">
            {% for client in clients.items %}
            <li>{{ client }}</li>
            {% endfor %}
        </ul>
        <ul class="marquee-content" aria-hidden="true">
            {% for client in clients.items %}
            <li>{{ client }}</li>
            {% endfor %}
        </ul>
    </div>
</div>
<div class="section section-fullwidth bg-dark text-light">
    <div class="masonry">
        {% for item in work.work | selectattr("featured") | sort(false, false, "featured_order") %}
            {% if loop.index <= 6 %}
                <div class="masonry-item{% if item.span %} masonry-item--wide{% endif %}">
                    <div class="fade-in{% if item.bg %} {{ item.bg }}{% endif %}">
                        {% if item.type === "image" %}
                            {% image item.src, item.alt %}
                        {% elif item.type === "slideshow" %}
                            <div class="slideshow slideshow-{{ item.slides | length }}{% if item.homepage_slideshow_slow %} slideshow-home-slow{% endif %}">
                                {% for slide in item.slides %}
                                    {% image slide.src, slide.alt %}
                                {% endfor %}
                            </div>
                        {% elif item.type === "video" %}
                            <video autoplay muted loop playsinline preload="metadata" width="100%" height="auto"{% if item.poster %} poster="{{ item.poster }}"{% endif %}>
                                <source src="{{ item.src }}">
                            </video>
                        {% elif item.type === "gif" %}
                            {% image item.src, item.alt, null, null, { gif: true } %}
                        {% endif %}
                    </div>
                    <div class="margin-top-small flex-row flex-align-baseline text-small uppercase">
                        <div class="flex-row flex-grow gap-small">
                            <span class="pixel-font">{{ item.title or item.alt }}</span>
                            <span class="pixel-font">/</span>
                            <span class="normal-case offset-up-1">{{ item.client or 'Personal work' }}</span>
                        </div>
                        <span class="tag tag-dark pixel-font uppercase">{{ item.category or 'Illustration' }}</span>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>
{# THE NOGOOD BOOK #}
<div class="section large-grid home-book bg-dark text-light">
    <div class="section-column sticky-two-rows">
        <div class="sticky-wrapper">
            <div class="sticky">
                <div class="spacer"></div>
                <h1 class="press-book-title header-extra-large mono uppercase">The<br>NoGood<br>Book</h1>
                <div class="spacer-large"></div>
            </div>
        </div>
        <div class="place-bottom">
            <p class="text-extra-large">A self-published monograph bringing together five years of illustration projects, outlining the backdrop for and context within which my work was created.</p>
            <div class="spacer"></div>
            <div class="order-option inner-column padding-small outline bg-offwhite">
                <div class="grid large-grid">
                    <h3 class="text-large"><s>Collectors edition</s></h3>
                    <h3 class="text-large align-right">Sold out</h3>
                </div>
            </div>
            <div class="spacer-small"></div>
            <div class="order-option inner-column outline padding-small">
                <div class="flex-space-between flex-align-start">
                    <div>
                        <h3 class="text-large nowrap">The NoGood Book</h3>
                        <p class="text-small">Signed &amp; numbered — <span data-book-stock data-book-inventory="{{ booksales.regular_inventory }}"></span> / {{ booksales.edition_size }} available</p>
                    </div>
                    <div class="align-right">
                        <h3 class="text-large pixel-font uppercase">€70</h3>
                        <p class="text-small">+ shipping</p>
                    </div>
                </div>
                <div class="spacer"></div>
                <div class="button-wrapper">
                    <a class="snipcart-add-item button pixel-font uppercase"
                        data-item-id="book-regular-edition" data-item-price="70"
                        data-item-url="/the-nogood-book/" data-item-description="The NoGood Book — first edition"
                        data-item-image="/assets/img/shop/snipcart/Snipcart_NoGoodBook_Regular.png" data-item-name="The NoGood Book"
                        data-item-weight="500" data-item-has-taxes-included="true"
                        data-umami-event="add-to-cart" data-umami-event-product="The NoGood Book">Purchase</a>
                </div>
            </div>
        </div>
    </div>
    <div class="section-column">
        <div class="zoom no-blend">
            <a href="/the-nogood-book/" aria-label="Explore The NoGood Book">
                <div class="slideshow slideshow-2 image-square home-book-slideshow">
                    {% image "source/assets/img/book/NG_Shoot_Book_Cover.jpg", "The NoGood Book cover", [720, 1400], "(min-width: 769px) 60vw, 100vw" %}
                    {% image "source/assets/img/book/NG_Shoot_Close_002.jpg", "Detail shot of The NoGood Book", [720, 1400], "(min-width: 769px) 60vw, 100vw" %}
                </div>
            </a>
        </div>
    </div>
</div>
<script type="module" src="/assets/js/book-stock.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => window.LoadSnipcart?.(), { once: true });
</script>
{# PATREON #}
<div class="section medium-grid patreon-section">
    <div class="section-column sticky-two-rows">
        <div class="sticky-wrapper">
            <div class="sticky">
                <h1>Support NoGood on <a href="https://patreon.com/bynogood" target="_blank" rel="noopener" data-umami-event="patreon-click" data-umami-event-location="heading">Patreon</a> and help me make more independent work.</h1>
                <div class="spacer-large"></div>
            </div>
        </div>
        <div class="place-bottom">
            <p class="text-large"><a href="https://patreon.com/bynogood" target="_blank" rel="noopener" data-umami-event="patreon-click" data-umami-event-location="paragraph">Patreon</a> is where I share the process and thinking behind my illustrations, look back on finished projects and talk about my obsessions shaping the new ones.</p>
            <div class="button-wrapper">
                <a href="https://patreon.com/bynogood" target="_blank" rel="noopener" class="button pixel-font uppercase" data-umami-event="patreon-click" data-umami-event-location="homepage">Join on Patreon</a>
            </div>
        </div>
    </div>
    <div class="section-column">
        <div class="patreon-illustration bg-dark no-blend image-padding">
            {% image "source/assets/img/NoGood_Selfpotrait.png", "NoGood self portrait" %}
        </div>
    </div>
    <div class="section-column hide-small">
        <div id="patreon-posts" class="inner-column sticky">
            <h5 class="uppercase pixel-font">Latest on Patreon</h5>
            <div class="spacer"></div>
            <div class="media-list">
                {% for post in patreonPosts %}
                    {% if loop.index <= 3 %}
                        <article class="outline padding-small">
                            {% if loop.first %}
                                <div class="zoom no-blend">
                                    <a href="{{ post.url }}" target="_blank" rel="noopener" data-umami-event="patreon-click" data-umami-event-location="latest-post-image">
                                        {% image post.image, post.title, [720, 1400], "(min-width: 769px) 25vw, 100vw" %}
                                    </a>
                                </div>
                                <a href="{{ post.url }}" target="_blank" rel="noopener" data-umami-event="patreon-click" data-umami-event-location="latest-post-title">{{ post.title }}</a>
                                <p>{{ post.intro }}</p>
                                <span class="text-small text-tabular">{{ post.publishedAt | postDate }}</span>
                            {% else %}
                                <div class="patreon-post-compact">
                                    <a href="{{ post.url }}" target="_blank" rel="noopener" class="patreon-post-thumbnail no-blend" data-umami-event="patreon-click" data-umami-event-location="latest-post-image">
                                        {% image post.image, post.title, [256], "48px" %}
                                    </a>
                                    <div class="patreon-post-info">
                                        <a href="{{ post.url }}" target="_blank" rel="noopener" data-umami-event="patreon-click" data-umami-event-location="latest-post-title">{{ post.title }}</a>
                                        <div class="spacer-small"></div>
                                        <span class="text-small text-tabular">{{ post.publishedAt | postDate }}</span>
                                    </div>
                                </div>
                            {% endif %}
                        </article>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{# RADIO INTRODUCTION #}
<div class="section medium-grid radio-intro bg-highlight hide-small">
    <div class="section-column radio-intro-stats">
        <h1 class="radio-intro-title header-extra-large mono uppercase">NoGood<br>Radio</h1>
        <div class="tag-row place-bottom">
            <span id="home-stream-viewers" class="tag tag-dark pixel-font uppercase" style="display:none;"></span>
            <span id="home-stream-uptime" class="tag pixel-font uppercase" style="display:none;"></span>
        </div>
    </div>
    <div class="section-column radio-intro-copy">
        <h2>A 24/7 pirate radio station running on scrap parts and broadcasting from a basement somewhere.</h2>
        <div id="home-radio-now-playing" class="home-radio-now-playing place-bottom" hidden>
            <a class="home-radio-current-track" data-current-track target="_blank" rel="noopener">
                <span class="soundbars" aria-hidden="true"><span></span><span></span><span></span></span>
                <span><span data-current-artist></span> — <span data-current-title></span></span>
            </a>
        </div>
    </div>
    <div class="section-column">
        <div class="inner-column">
            <h5 class="uppercase pixel-font">Latest Radio zaps</h5>
            <div class="spacer-small"></div>
            <div id="home-radio-zap-feed" class="zap-feed animate-in"></div>
        </div>
    </div>
</div>

{# RADIO #}
<div class="section relative hide-small bg-highlight">
    {# VIDEO #}
    <div class="section-column no-blend">
        <div id="home-radio-player" class="home-radio-player video-fill">
            <video id="home-stream-video" playsinline></video>
            <div id="home-stream-play-overlay" class="home-radio-play-overlay">
                <button id="home-stream-play" class="embed-play home-radio-play-button" aria-label="Play NoGood Radio"></button>
            </div>
            <div id="home-stream-controls" class="home-radio-controls" hidden>
                <button id="home-stream-play-pause" class="home-radio-control-button" aria-label="Pause">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 2h4v12H3zm6 0h4v12H9z"/></svg>
                </button>
                <span class="home-radio-live-badge pixel-font uppercase">Live</span>
                <div class="home-radio-controls-spacer"></div>
                <button id="home-stream-mute" class="home-radio-control-button" aria-label="Mute">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 5v6h3l5 4V1L5 5H2z"/><path d="M11.5 5.5a4 4 0 0 1 0 5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
                </button>
                <div id="home-quality-selector" class="home-radio-quality" hidden>
                    <button id="home-quality-toggle" class="home-radio-control-button home-radio-quality-toggle pixel-font uppercase" aria-label="Video quality">
                        <span id="home-quality-label">Auto</span>
                    </button>
                    <div id="home-quality-menu" class="home-radio-quality-menu"></div>
                </div>
                <button id="home-stream-fullscreen" class="home-radio-control-button" aria-label="Fullscreen">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"/></svg>
                </button>
            </div>
        </div>
    </div>
</div>
<script type="module">
    import { initCurrentTrack } from '/assets/js/radio/lastfm.js';
    import { initStandaloneStreamInfo } from '/assets/js/radio/stream-info.js';

    initCurrentTrack('home-radio-now-playing');
    initStandaloneStreamInfo({
        viewers: document.getElementById('home-stream-viewers'),
        uptime: document.getElementById('home-stream-uptime')
    });

    const player = document.getElementById('home-radio-player');
    const video = document.getElementById('home-stream-video');
    const playOverlay = document.getElementById('home-stream-play-overlay');
    const playButton = document.getElementById('home-stream-play');
    const controls = document.getElementById('home-stream-controls');
    const playPauseButton = document.getElementById('home-stream-play-pause');
    const muteButton = document.getElementById('home-stream-mute');
    const fullscreenButton = document.getElementById('home-stream-fullscreen');
    const PLAY_ICON = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 2l10 6-10 6z"/></svg>';
    const PAUSE_ICON = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 2h4v12H3zm6 0h4v12H9z"/></svg>';
    const VOLUME_ICON = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 5v6h3l5 4V1L5 5H2z"/><path d="M11.5 5.5a4 4 0 0 1 0 5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>';
    const MUTED_ICON = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 5v6h3l5 4V1L5 5H2z"/><path d="m11 5 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>';
    const FULLSCREEN_ICON = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"/></svg>';
    const FULLSCREEN_EXIT_ICON = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 2v4H2M14 6h-4V2M10 14v-4h4M2 10h4v4"/></svg>';
    const HLS_URL = 'https://api-core.zap.stream/537a365c-f1ec-44ac-af10-22d14a7319fb/hls/live.m3u8';
    const FALLBACK = '/assets/img/radio-bg.mp4';
    function useFallback() {
        video.src = FALLBACK;
        video.loop = true;
        video.play().catch(() => {});
    }
    function updatePlayPauseButton() {
        playPauseButton.innerHTML = video.paused ? PLAY_ICON : PAUSE_ICON;
        playPauseButton.setAttribute('aria-label', video.paused ? 'Play' : 'Pause');
    }
    function updateMuteButton() {
        muteButton.innerHTML = video.muted ? MUTED_ICON : VOLUME_ICON;
        muteButton.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
    }
    function updateFullscreenButton() {
        const isFullscreen = Boolean(document.fullscreenElement || document.webkitFullscreenElement);
        fullscreenButton.innerHTML = isFullscreen ? FULLSCREEN_EXIT_ICON : FULLSCREEN_ICON;
        fullscreenButton.setAttribute('aria-label', isFullscreen ? 'Exit fullscreen' : 'Fullscreen');
    }
    function buildQualitySelector(hls) {
        const selector = document.getElementById('home-quality-selector');
        const toggle = document.getElementById('home-quality-toggle');
        const menu = document.getElementById('home-quality-menu');
        const label = document.getElementById('home-quality-label');
        const levels = hls.levels;
        if (!levels || levels.length <= 1 || menu.children.length) return;

        selector.hidden = false;
        const options = [{ label: 'Auto', level: -1 }, ...levels.map((level, index) => ({
            label: `${level.height}p`,
            level: index
        }))];
        for (const option of options) {
            const button = document.createElement('button');
            button.className = `home-radio-quality-option pixel-font uppercase${option.level === -1 ? ' is-active' : ''}`;
            button.textContent = option.label;
            button.dataset.level = String(option.level);
            menu.appendChild(button);
        }
        toggle.addEventListener('click', event => {
            event.stopPropagation();
            menu.classList.toggle('is-open');
        });
        menu.addEventListener('click', event => {
            const button = event.target.closest('.home-radio-quality-option');
            if (!button) return;
            const level = Number(button.dataset.level);
            hls.currentLevel = level;
            label.textContent = level === -1 ? 'Auto' : levels[level].height + 'p';
            menu.querySelectorAll('.home-radio-quality-option').forEach(option => option.classList.remove('is-active'));
            button.classList.add('is-active');
            menu.classList.remove('is-open');
        });
        selector.addEventListener('click', event => event.stopPropagation());
        document.addEventListener('click', () => menu.classList.remove('is-open'));
    }
    video.addEventListener('playing', () => {
        playOverlay.hidden = true;
        controls.hidden = false;
        player.classList.add('has-started');
        updatePlayPauseButton();
    });
    video.addEventListener('pause', updatePlayPauseButton);
    video.addEventListener('volumechange', updateMuteButton);
    playButton.addEventListener('click', () => {
        video.play().catch(() => {});
    });
    playPauseButton.addEventListener('click', () => {
        if (video.paused) video.play().catch(() => {});
        else video.pause();
    });
    muteButton.addEventListener('click', () => {
        video.muted = !video.muted;
    });
    fullscreenButton.addEventListener('click', () => {
        const fullscreenElement = document.fullscreenElement || document.webkitFullscreenElement;
        if (!fullscreenElement) {
            const requestFullscreen = player.requestFullscreen || player.webkitRequestFullscreen;
            if (requestFullscreen) Promise.resolve(requestFullscreen.call(player)).catch(() => {});
        } else {
            const exitFullscreen = document.exitFullscreen || document.webkitExitFullscreen;
            if (exitFullscreen) Promise.resolve(exitFullscreen.call(document)).catch(() => {});
        }
    });
    document.addEventListener('fullscreenchange', updateFullscreenButton);
    document.addEventListener('webkitfullscreenchange', updateFullscreenButton);
    updatePlayPauseButton();
    updateMuteButton();
    updateFullscreenButton();
    async function initStream() {
        if (video.canPlayType('application/vnd.apple.mpegurl')) {
            video.src = HLS_URL;
            video.play().catch(() => {});
            video.addEventListener('error', useFallback);
        } else {
            const { default: Hls } = await import('/assets/js/vendor/hls.js');
            if (!Hls.isSupported()) {
                useFallback();
                return;
            }
            const hls = new Hls({ enableWorker: true, startLevel: 0 });
            hls.loadSource(HLS_URL);
            hls.attachMedia(video);
            hls.on(Hls.Events.MANIFEST_PARSED, () => {
                video.play().catch(() => {});
                buildQualitySelector(hls);
            });
            hls.on(Hls.Events.ERROR, (_e, data) => {
                if (data.fatal) { hls.destroy(); useFallback(); }
            });
        }
    }
    new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
            obs.disconnect();
            initStream();
        }
    }, { threshold: 0.1 }).observe(video);
</script>
