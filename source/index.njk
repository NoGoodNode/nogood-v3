    <div class="marquee pixel-font header-large uppercase">
        <ul class="marquee-content">
            <li>Shop NoGood Merch</li>
            <li>Shop NoGood Merch</li>
            <li>Shop NoGood Merch</li>
            <li>Shop NoGood Merch</li>
        </ul>
        <ul aria-hidden="true" class="marquee-content">
            <li>Shop NoGood Merch</li>
            <li>Shop NoGood Merch</li>
            <li>Shop NoGood Merch</li>
            <li>Shop NoGood Merch</li>
        </ul>
    </div>
</div>
{# SHOP #}
<div class="section home-shop large-grid">
    {# INTRO #}
    <div class="section-column sticky-two-rows">
        <div class="sticky-wrapper">
            <div class="sticky">
                <div class="home-shop-intro">
                    <h1>
                        Limited runs, produced locally. Shipped with care from the studio in Amsterdam.
                    </h1>
                </div>
            </div>
        </div>
    </div>
    {# GRID #}
    <div class="section-column large-grid">
        {# BOOK FEATURE #}
        <div id="shop-header" class="no-blend fade-in">
            <a href="/the-nogood-book/">
                <video autoplay muted loop playsinline preload="metadata">
                    <source src="/assets/img/book/book-shoot.mp4" type="video/mp4">
                </video>
            </a>
        </div>
        <div class="item-info">
            <h4 class="pixel-font uppercase">
                <a href="/the-nogood-book/">The NoGood Book — €70</a>
            </h4>
            <div class="spacer-small hide-medium hide-large"></div>
            <p class="text-large">A monograph bringing together five years worth of NoGood illustration
                projects, outlining the backdrop for and context within which my work was created.</p>
        </div>
        <div class="inner-column hide-small"></div>
        <div class="grid-span-full border-bottom"></div>
        {# REGULAR ITEMS #}
        {% include "source/snippets/product-grid.njk" %}
    </div>
</div>
{# BLOG #}
<div class="section home-blog medium-grid bg-dark">
    <div class="section-column sticky-two-rows">
        <div class="sticky-wrapper">
            <div class="sticky">
                <h1>Studio notes, updates, and behind-the-scenes from ongoing projects.</h1>
            </div>
        </div>
        <div class="spacer-large"></div>
    </div>
    <div class="section-column">
        <div class="inner-column sticky">
            <video autoplay muted loop playsinline preload="metadata" poster="/assets/img/book/Book_Promo_Poster.jpg">
                <source src="/assets/img/book-promo.mp4" type="video/mp4">
            </video>
            <div class="spacer"></div>
            <h4 class="uppercase pixel-font">Blog</h4>
            <div class="spacer-large"></div>
            <div class="list tag-list">
                {% for post in collections.feedPosts %}
                {% include "source/snippets/list-tag.njk" %}
                {% endfor %}
            </div>
            <div class="spacer-extralarge"></div>
            <h4 class="uppercase pixel-font">Podcast appearances</h4>
            <div class="spacer-large"></div>
            <div class="list two-col-list">
                {% for episode in podcasts.episodes | reverse %}
                    <div><a href="{{ episode.url }}" target="_blank" rel="noopener">{{ episode.show }}</a></div>
                    <div class="align-right text-tabular">{{ episode.date | postDate }}</div>
                    <div class="row-border"></div>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="section-column">
        <div class="inner-column sticky">
        {% set clippingsItems = collections.clippingsHome %}
        {% include "source/snippets/clippings.njk" %}
        </div>
    </div>
</div>
<script type="module" src="/assets/js/zap-feed.js"></script>