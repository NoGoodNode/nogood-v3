---
pagination:
  data: legacyRedirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}/index.html"
eleventyExcludeFromCollections: true
unlisted: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ settings.metadata.site_url }}{{ redirect.to }}">
  <meta http-equiv="refresh" content="0; url={{ redirect.to }}">
  <title>Page moved</title>
  <script>location.replace({{ redirect.to | json | safe }} + location.search + location.hash);</script>
</head>
<body>
  <p>This page has moved to <a href="{{ redirect.to }}">{{ redirect.to }}</a>.</p>
</body>
</html>
