---
layout: overlay
title: NoGood Overlay
permalink: /overlay/nogood-main/
eleventyExcludeFromCollections: true
bodyClass: overlay
stylesheets:
  - /assets/css/overlays/drawing/tokens.css
  - /assets/css/overlays/drawing/base.css
  - /assets/css/overlays/drawing/utilities.css
  - /assets/css/overlays/drawing/components.css
  - /assets/css/overlays/drawing/main.css
---

<div id="capture-viewport" class="absolute" aria-label="Screen capture frame">
  <svg viewBox="0 0 1220 1018" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <mask id="capture-hole-mask">
        <rect width="1220" height="1018" fill="white" />
        <rect x="24" y="24" width="1172" height="970" rx="12" fill="black" />
      </mask>
    </defs>
    <rect width="1220" height="1018" fill="black" mask="url(#capture-hole-mask)" />
  </svg>
</div>
<div id="lower-bar" class="absolute flex items-center bg-accent px-4 gap-5 overflow-hidden">
  <span class="font-display text-lg text-bg uppercase shrink-0 nudge-down-2">Zap Messages</span>
  <div class="ticker-viewport flex-1">
    <div id="zap-feed-track" class="ticker-track flex items-center whitespace-nowrap" aria-live="polite"></div>
  </div>
</div>
<div id="status-bar" class="absolute flex items-center justify-end bg px-4">
  <span id="viewer-count" class="font-mono text-sm text-light uppercase">0 viewers</span>
</div>

<aside id="info-sidebar" class="absolute flex column justify-between bg-panel p-4">
  <div class="flex column gap-6">
  <section class="flex column gap-1">
    <h2 class="section-label">Mempool</h2>
    <div class="stat-row"><span class="stat-label">Block</span><span id="bitcoin-block" class="stat-value font-mono text-sm uppercase">—</span></div>
    <div class="stat-row"><span class="stat-label">Fee</span><span id="bitcoin-fee" class="stat-value font-mono text-sm uppercase">—</span></div>
    <div class="stat-row"><span class="stat-label">Mempool</span><span id="bitcoin-mempool" class="stat-value font-mono text-sm uppercase">—</span></div>
    <div class="stat-row"><span class="stat-label">Difficulty</span><span id="bitcoin-difficulty" class="stat-value font-mono text-sm uppercase">—</span></div>
    </section>

    <section class="flex column gap-2">
      <h2 class="section-label">Top Zappers</h2>
      <div id="zap-leaderboard" class="flex column gap-2 overflow-hidden">
        <p class="notification">Loading zaps</p>
      </div>
    </section>
  </div>

  <section class="flex column gap-2">
    <h2 class="section-label">Activity</h2>
    <div id="notification-center" class="flex column gap-2 overflow-hidden">
      <p class="notification">Waiting for activity</p>
    </div>
  </section>
</aside>

<aside id="chat-column" class="absolute flex column bg-panel text-light overflow-hidden">
  <div id="chat-box" class="absolute overflow-hidden">
    <div id="chat-list" class="absolute bottom-4 left-4 right-4 flex column gap-2"></div>
  </div>
</aside>

<script>
  window.OVERLAY_CONFIG = {
    naddr: 'naddr1qqjrvwfcv33nydfk94jxgcnr956xzdpk95ukxdmr95crvvrxvfjxzdesvesnqqgwwaehxw309ahx7uewd3hkctczyr85tf46zd366lkjzws83ecs6fq3ttnjrjd500g7haz936h0knp22qcyqqq8vecq9aw68',
    relays: ['wss://relay.primal.net', 'wss://nos.lol', 'wss://relay.damus.io', 'wss://relay.nogood.tech'],
    profilePubkey: '55f04590674f3648f4cdc9dc8ce32da2a282074cd0b020596ee033d12d385185',
  };
</script>

<script type="module">
  import { createOverlayData } from '/assets/js/overlay/nostr-data.js';
  import { appendAnimatedChatMessage } from '/assets/js/overlay/chat-feed.js';

  // Future overlay UI can use window.overlayData to subscribe only to the
  // stream and account feeds it needs.
  window.overlayData = createOverlayData(window.OVERLAY_CONFIG);

  const chatList = document.getElementById('chat-list');
  const zapFeedTrack = document.getElementById('zap-feed-track');
  const zapFeedViewport = zapFeedTrack?.parentElement;
  const latestZaps = new Map();
  let zapFeedRenderTimer = null;
  const viewerCount = document.getElementById('viewer-count');
  const botPubkey = 'c0434367d3e598555e930db7d54eb5e2b4013c0b7673c8f668475fc76b6a6606';

  function appendHistoricalMessage(card, timestamp) {
    card.dataset.timestamp = String(timestamp || 0);
    const newerMessage = [...chatList.children].find(child => Number(child.dataset.timestamp) > timestamp);
    if (newerMessage) chatList.insertBefore(card, newerMessage);
    else chatList.appendChild(card);
  }

  function appendStreamMessage(message, isHistorical, variant = '') {
    const card = document.createElement('article');
    const isOwner = message.pubkey === window.OVERLAY_CONFIG.profilePubkey;
    const isBot = message.pubkey === botPubkey;
    card.className = `chat-message ${variant} ${isOwner ? 'chat-message--owner' : ''} ${isBot ? 'chat-message--bot' : ''} column gap-1 rounded-md`;

    const sender = document.createElement('span');
    sender.className = `${isBot ? 'chat-message__sender--bot' : 'text-accent'} font-mono text-sm uppercase`;
    sender.textContent = '…';
    const content = document.createElement('span');
    content.textContent = message.content;
    card.append(sender, content);

    if (isHistorical) appendHistoricalMessage(card, message.timestamp);
    else appendAnimatedChatMessage(chatList, card);

    window.overlayData.fetchProfile(message.pubkey).then(profile => {
      sender.textContent = profile.name || 'anon';
    }).catch(() => { sender.textContent = 'anon'; });
  }

  window.overlayData.subscribeStreamChat((message, isHistorical) => {
    appendStreamMessage(message, isHistorical);
  });

  window.overlayData.subscribeStreamRaids((raid, isHistorical) => {
    appendStreamMessage({ ...raid, content: `RAID FROM ${raid.content || 'ANON'}` }, isHistorical, 'chat-message--raid');
  });

  function appendStreamZap(zap, isHistorical) {
    const card = document.createElement('article');
    const isLowValue = zap.amount < 1000;
    card.className = `chat-message ${isLowValue ? 'chat-message--zap-low' : 'chat-message--zap'} column gap-1 rounded-md`;

    const header = document.createElement('div');
    header.className = 'flex items-center gap-2';
    const amount = document.createElement('span');
    amount.className = `font-display text-lg ${isLowValue ? 'text-accent' : ''}`;
    amount.textContent = `⚡ ${zap.amount.toLocaleString()}`;
    const sender = document.createElement('span');
    sender.className = 'font-mono text-lg uppercase';
    sender.textContent = '…';
    header.append(amount, sender);
    card.appendChild(header);

    if (zap.content) {
      const content = document.createElement('span');
      content.textContent = zap.content;
      card.appendChild(content);
    }

    if (isHistorical) appendHistoricalMessage(card, zap.timestamp);
    else appendAnimatedChatMessage(chatList, card);

    window.overlayData.fetchProfile(zap.senderPubkey).then(profile => {
      sender.textContent = profile.name || 'anon';
    }).catch(() => { sender.textContent = 'anon'; });
  }

  window.overlayData.subscribeStreamZaps(appendStreamZap);

  window.overlayData.subscribeStreamInfo(info => {
    viewerCount.textContent = `${info.viewers ?? 0} viewers`;
  });

  const zapLeaderboard = document.getElementById('zap-leaderboard');
  const zapLeaders = new Map();
  let leaderboardRenderTimer = null;

  function queueLeaderboardRender() {
    if (leaderboardRenderTimer) return;
    leaderboardRenderTimer = setTimeout(() => {
      leaderboardRenderTimer = null;
      renderZapLeaderboard();
    }, 10_000);
  }

  function renderZapLeaderboard() {
    if (!zapLeaderboard) return;
    const leaders = [...zapLeaders.values()]
      .sort((a, b) => b.sats - a.sats)
      .slice(0, 8);

    zapLeaderboard.replaceChildren();
    leaders.forEach(leader => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2';

      const avatar = document.createElement('img');
      avatar.className = 'size-avatar rounded-full object-cover bg-panel-light';
      avatar.alt = '';
      if (leader.avatar) avatar.src = leader.avatar;

      const name = document.createElement('span');
      name.className = 'font-mono text-sm text-light uppercase truncate flex-1';
      name.textContent = leader.name || 'anon';

      const amount = document.createElement('span');
      amount.className = 'font-display text-sm text-accent';
      amount.textContent = `⚡ ${leader.sats.toLocaleString()}`;

      row.append(avatar, name, amount);
      zapLeaderboard.appendChild(row);

      if (!leader.profileRequested && leader.pubkey) {
        leader.profileRequested = true;
        window.overlayData.fetchProfile(leader.pubkey).then(profile => {
          leader.name = profile.name || leader.name;
          leader.avatar = profile.picture || leader.avatar;
          queueLeaderboardRender();
        }).catch(() => {});
      }
    });
  }

  function queueZapFeedRender() {
    if (zapFeedRenderTimer) return;
    zapFeedRenderTimer = setTimeout(() => {
      zapFeedRenderTimer = null;
      renderZapFeed();
    }, 1_000);
  }

  function renderZapFeed() {
    if (!zapFeedTrack) return;
    const zaps = [...latestZaps.values()]
      .sort((a, b) => b.timestamp - a.timestamp)
      .slice(0, 12);
    if (!zaps.length) return;

    const sequence = document.createElement('div');
    sequence.className = 'ticker-group flex items-center gap-8 pr-8';
    zaps.forEach(zap => {
      const item = document.createElement('div');
      item.className = 'flex items-center gap-2';

      const amount = document.createElement('span');
      amount.className = 'font-display text-lg text-bg nudge-down-2';
      amount.textContent = `⚡ ${zap.amount.toLocaleString()}`;

      const sender = document.createElement('span');
      sender.className = 'font-mono text-lg text-bg uppercase';
      sender.textContent = zap.name || '…';
      item.append(amount, sender);

      if (zap.content) {
        const content = document.createElement('span');
        content.className = 'font-mono text-sm text-bg';
        content.textContent = zap.content;
        item.appendChild(content);
      }
      sequence.appendChild(item);

      if (!zap.profileRequested && zap.senderPubkey) {
        zap.profileRequested = true;
        window.overlayData.fetchProfile(zap.senderPubkey).then(profile => {
          zap.name = profile.name || 'anon';
          queueZapFeedRender();
        }).catch(() => { zap.name = 'anon'; });
      }
    });

    zapFeedTrack.replaceChildren(sequence);
    requestAnimationFrame(buildSeamlessZapFeed);
  }

  window.overlayData.subscribeCombinedZaps(zap => {
    const key = zap.senderPubkey || zap.id;
    const leader = zapLeaders.get(key) || {
      sats: 0,
      name: 'anon',
      avatar: '',
      pubkey: zap.senderPubkey,
      profileRequested: false,
    };
    leader.sats += zap.amount;
    zapLeaders.set(key, leader);
    queueLeaderboardRender();

    latestZaps.set(zap.id, { ...zap, name: '', profileRequested: false });
    if (latestZaps.size > 200) {
      const oldest = [...latestZaps.values()].sort((a, b) => a.timestamp - b.timestamp)[0];
      latestZaps.delete(oldest.id);
    }
    queueZapFeedRender();
  });

  const bitcoinBlock = document.getElementById('bitcoin-block');
  const bitcoinFee = document.getElementById('bitcoin-fee');
  const bitcoinMempool = document.getElementById('bitcoin-mempool');
  const bitcoinDifficulty = document.getElementById('bitcoin-difficulty');

  async function updateBitcoinStats() {
    try {
      const [block, mempool, fees, difficulty] = await Promise.all([
        fetch('https://mempool.space/api/blocks/tip/height').then(response => response.text()),
        fetch('https://mempool.space/api/mempool').then(response => response.json()),
        fetch('https://mempool.space/api/v1/fees/recommended').then(response => response.json()),
        fetch('https://mempool.space/api/v1/difficulty-adjustment').then(response => response.json()),
      ]);
      bitcoinBlock.textContent = Number(block).toLocaleString();
      bitcoinFee.textContent = `${fees.halfHourFee} sat/vB`;
      bitcoinMempool.textContent = `${Number(mempool.count).toLocaleString()} tx`;
      bitcoinDifficulty.textContent = `${difficulty.difficultyChange >= 0 ? '+' : ''}${difficulty.difficultyChange.toFixed(2)}%`;
    } catch {
      bitcoinBlock.textContent = '—';
      bitcoinFee.textContent = '—';
      bitcoinMempool.textContent = '—';
      bitcoinDifficulty.textContent = '—';
    }
  }

  updateBitcoinStats();
  setInterval(updateBitcoinStats, 60_000);

  function buildSeamlessZapFeed() {
    if (!zapFeedTrack || !zapFeedViewport || !zapFeedTrack.firstElementChild) return;
    const itemTemplate = zapFeedTrack.firstElementChild.cloneNode(true);
    const group = document.createElement('div');
    group.className = 'ticker-group flex items-center';

    zapFeedTrack.replaceChildren(group);

    // Repeat complete zap items until one group is wider than the visible feed.
    do {
      group.appendChild(itemTemplate.cloneNode(true));
    } while (group.scrollWidth < zapFeedViewport.clientWidth * 1.5);

    const duplicate = group.cloneNode(true);
    duplicate.setAttribute('aria-hidden', 'true');
    zapFeedTrack.appendChild(duplicate);

    const distance = group.getBoundingClientRect().width;
    zapFeedTrack.style.setProperty('--ticker-distance', `-${distance}px`);
    zapFeedTrack.style.animation = 'none';
    void zapFeedTrack.offsetWidth;
    zapFeedTrack.style.animation = '';
  }

  document.fonts?.ready.then(buildSeamlessZapFeed) || buildSeamlessZapFeed();
  window.addEventListener('resize', buildSeamlessZapFeed);
</script>
