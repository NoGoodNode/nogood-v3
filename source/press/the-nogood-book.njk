<section class="section bg-dark text-light padding-bottom-small">
  <div class="section-column">
    <h1 class="padding-right-small">Press materials for The NoGood Book—a self-published monograph bringing together five years of illustration projects, outlining the backdrop for and context within which my work was created.</h1>
  </div>
</section>

<section class="section large-grid bg-dark text-light">
  <div class="section-column sticky-two-rows">
    <div class="sticky-wrapper">
      <div class="sticky">
        <p class="pixel-font uppercase">Press kit / Volume 1</p>
        <div class="spacer"></div>
        <h1 class="press-book-title header-extra-large mono uppercase">The<br>NoGood<br>Book</h1>
        <div class="spacer-large"></div>
      </div>
    </div>
    <div class="place-bottom">
      <p class="text-extra-large padding-right-small">Self-published and crowdfunded, The NoGood Book brings together five years of work. It collects illustration projects and process snapshots from an independent practice, while tracing the convictions behind it.</p>
      <div class="spacer"></div>
      <div class="press-actions">
        <div class="press-actions__downloads">
          <a class="button icon download-icon pixel-font uppercase" href="{{ bookpress.downloads.press_kit.url }}" download data-umami-event="press-kit-download" data-umami-event-format="{{ bookpress.downloads.press_kit.format }}" data-umami-event-location="hero">Press Kit / {{ bookpress.downloads.press_kit.format }}</a>
          <a class="button icon external-icon pixel-font uppercase" href="{{ bookpress.downloads.image_collection.url }}" target="_blank" rel="noopener" data-umami-event="press-image-bank-click" data-umami-event-provider="{{ bookpress.downloads.image_collection.provider }}" data-umami-event-location="hero">Image Bank</a>
        </div>
      </div>
    </div>
  </div>
  <div class="section-column no-blend">
    <div class="press-opener-image">
      {% image "source/assets/img/press/book-vol1/featured/the-nogood-book-photo-01-cover-stack.jpg", "Three copies of The NoGood Book showing its illustrated red cover", [720, 1500, 2400], "(min-width: 720px) 50vw, 100vw", { eager: true } %}
    </div>
  </div>
</section>

<section class="section section-fullwidth bg-offwhite">
