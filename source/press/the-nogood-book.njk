<section class="section section-fullwidth">
  <div class="masonry press-masonry">
    {% for item in bookpress.media %}
    {% set previewSource = bookpress.assets.preview_source ~ "/" ~ item.folder ~ "/" ~ item.filename %}
    {% set previewUrl = bookpress.assets.preview_url ~ "/" ~ item.folder ~ "/" ~ item.filename %}
    {% set downloadUrl = bookpress.assets.download_url ~ "/" ~ item.folder ~ "/" ~ item.filename %}
    <article class="masonry-item{% if item.span %} masonry-item--wide{% endif %}">
      <div class="fade-in">
        {% if item.type === "image" %}
          {% image previewSource, item.alt %}
        {% elif item.type === "video" %}
          <video autoplay muted loop playsinline preload="metadata" width="100%" height="auto" aria-label="{{ item.alt }}">
            <source src="{{ previewUrl }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
      <div class="margin-top-small flex-row flex-align-baseline text-small uppercase">
        <div class="flex-row flex-grow gap-small">
          <span class="pixel-font">{{ item.title }}</span>
          <span class="normal-case offset-up-1"><span class="press-copyright">© {{ item.credit }}</span>{% if item.photography_credit %} {{ item.photography_credit }}{% endif %}</span>
        </div>
        <a class="tag tag-dark pixel-font uppercase" href="{{ downloadUrl }}" data-umami-event="press-asset-download" data-umami-event-asset="{{ item.title }}" data-umami-event-filename="{{ item.filename }}" data-umami-event-type="{{ item.type }}" data-umami-event-format="{{ item.format }}">{{ item.download_label }}</a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<section id="crowdfunding" class="section large-grid bg-offwhite">
  <div class="section-column">
    <div class="sticky">
      <h2>The book was partly funded through a bitcoin-only crowdfund campaign. I shared irregular updates throughout production, offering a peek behind the scenes as its design kept shapeshifting.</h2>
      <div class="spacer-extralarge hide-medium hide-large"></div>
    </div>
  </div>
  <div class="section-column">
    <div class="inner-column">
      <video autoplay muted loop playsinline preload="metadata" poster="/assets/img/book/Book_Promo_Poster.jpg">
        <source src="/assets/img/book-promo.mp4" type="video/mp4">
      </video>
      <div class="spacer"></div>
      <h4 class="uppercase pixel-font">Book Updates</h4>
      <div class="spacer-small"></div>
      <div class="list tag-list">
        {% for post in collections.feedPosts %}
        {% include "source/snippets/list-tag.njk" %}
        {% endfor %}
      </div>
      <div class="spacer-extralarge"></div>
      <h4 class="uppercase pixel-font">Podcast appearances</h4>
      <div class="spacer-small"></div>
      <div class="list two-col-list">
        {% for episode in podcasts.episodes | reverse %}
          <div><a href="{{ episode.url }}" target="_blank" rel="noopener">{{ episode.show }}</a></div>
          <div class="align-right text-tabular">{{ episode.date | postDate }}</div>
          <div class="row-border"></div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

