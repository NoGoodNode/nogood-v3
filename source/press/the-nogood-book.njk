    <div class="list two-col-list">
      <div>Artwork credit</div><div class="align-right"><a href="{{ bookpress.credits.artwork.url }}">{{ bookpress.credits.artwork.name }}</a></div><div class="row-border"></div>
      <div>Photography credit</div><div class="align-right"><a href="{{ bookpress.credits.photography.url }}" target="_blank" rel="noopener">{{ bookpress.credits.photography.name }}</a></div><div class="row-border"></div>
